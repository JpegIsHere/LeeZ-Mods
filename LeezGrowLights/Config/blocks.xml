<?xml version="1.0" encoding="UTF-8"?>
<configs>
    <!--
      V0.2 visual/power scaffold.
      Uses the vanilla player ceiling-light behavior for wiring/on-off control,
      but swaps the visible prefab to the White LED Light Panel seen in the supplied screenshot.

      Vanilla panel prefab:
        @:Entities/Electrical/lightPanelLEDPrefab.prefab

      Runtime grow-speed and selectable color still require the LeezGrowLights DLL.
    -->
    <append xpath="/blocks">
        <block name="leezGrowLightT1">
            <property name="Extends" value="ceilingLight01_player" />
            <property name="CreativeMode" value="Player" />
            <property name="CustomIcon" value="lightPanelLEDWhite" />
            <property name="Model" value="#@modfolder:Resources/LeeZGrowLights_T1_Test6.unity3d?LeeZGrowLight_T1_Prefab" />
            <property name="ModelOffset" value="0,1,0" />
            <property name="HandleFace" value="Top" />
            <property name="RequiredPower" value="10" />
            <property name="DescriptionKey" value="leezGrowLightT1Desc" />
            <property name="LeezGrowTier" value="1" />
            <property name="LeezGrowMultiplier" value="1.2" />
            <property name="LeezGrowRadius" value="2" />
            <property name="LeezGrowMinFarmBlockVerticalOffset" value="1" />
            <property name="LeezGrowMaxFarmBlockVerticalOffset" value="10" />
            <property name="LeezGrowAllowedColors" value="Blue,Green,Red,Purple,White,Yellow" />
            <property name="LeezGrowDefaultColor" value="White" />
        </block>

        <block name="leezGrowLightT2">
