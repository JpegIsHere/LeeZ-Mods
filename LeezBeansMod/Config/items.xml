<?xml version="1.0" encoding="UTF-8"?>
<configs>
    <append xpath="/items">
        <!--
          Extending foodCropGraceCorn intentionally keeps Super Corn's raw-food,
          stack, economic and use mechanics as the starting balance.
        -->
        <item name="foodCropLeezBeans">
            <property name="Extends" value="foodCropGraceCorn" />
            <property name="CustomIcon" value="foodCropGraceCorn" />
            <property name="DescriptionKey" value="foodCropLeezBeansDesc" />
        </item>

        <!-- Same read-to-unlock pattern used by the Super Corn seed recipe. -->
        <item name="plantedLeezBeans1Schematic">
            <property name="Extends" value="schematicNoQualityRecipeMaster" />
            <property name="CreativeMode" value="Player" />
            <property name="CustomIcon" value="plantedGraceCorn3Harvest" />
            <property name="Unlocks" value="plantedLeezBeans1" />
            <effect_group tiered="false">
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="plantedLeezBeans1" operation="set" value="1" />
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="GiveExp" exp="50" />
            </effect_group>
        </item>
    </append>
</configs>
